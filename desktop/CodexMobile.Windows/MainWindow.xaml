<Window x:Class="CodexMobile.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Codex Mobile · Windows" Width="1180" Height="760" MinWidth="780" MinHeight="500"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">
  <Grid Background="{StaticResource WindowBrush}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="300"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
      <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="CODEX MOBILE" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="2,4,0,16"/>
          <TextBlock Text="服务器" Foreground="{StaticResource MutedBrush}" Margin="2,0,0,5"/>
          <TextBox x:Name="ServerBox" Text="https://codex-go.arcsiny.com/" Margin="0,0,0,10"/>
          <TextBlock Text="访问口令" Foreground="{StaticResource MutedBrush}" Margin="2,0,0,5"/>
          <PasswordBox x:Name="TokenBox" Background="{StaticResource InputBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush}" Padding="8,6" Margin="0,0,0,10"/>
          <Button x:Name="ConnectButton" Content="连接" Click="Connect_Click" Background="{StaticResource AccentBrush}" BorderThickness="0" Margin="0,0,0,12"/>
          <TextBlock x:Name="ConnectionText" Text="未连接" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="2,0,0,16"/>
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="会话" Foreground="{StaticResource TextBrush}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="＋ 新建" Click="New_Click"/>
          </Grid>
          <Button Content="刷新会话" Click="Refresh_Click" HorizontalAlignment="Stretch" Margin="0,0,0,10"/>
        </StackPanel>
        <ListBox x:Name="ThreadList" SelectionChanged="ThreadList_SelectionChanged"
                 Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}"
                 HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="4,7">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Cwd}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" Background="{StaticResource WindowBrush}">
      <Grid.RowDefinitions>
        <RowDefinition Height="52"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Border Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,0">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="TitleText" Text="选择会话或新建会话" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          <Button x:Name="StopButton" Grid.Column="1" Content="停止" Click="Stop_Click" Visibility="Collapsed" VerticalAlignment="Center"/>
        </Grid>
      </Border>
      <ScrollViewer x:Name="TranscriptScroll" Grid.Row="1" Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}" VerticalScrollBarVisibility="Auto" Padding="24,18">
        <StackPanel x:Name="TranscriptPanel"/>
      </ScrollViewer>
      <Border Grid.Row="2" Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,14">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBox x:Name="ComposerBox" MinHeight="76" MaxHeight="180" AcceptsReturn="True" TextWrapping="Wrap"
                   VerticalScrollBarVisibility="Auto" KeyDown="Composer_KeyDown"/>
          <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Enter 发送 · Shift+Enter 换行" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/>
            <Button x:Name="SendButton" Grid.Column="1" Content="发送" Click="Send_Click" Background="{StaticResource AccentBrush}" BorderThickness="0" MinWidth="84"/>
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
