import { Palette, LineEdit, TextEdit, ListView, ComboBox, CheckBox } from "std-widgets.slint";

export struct ThreadRow { id: string, title: string, cwd: string, status: string, meta: string }
export struct MessageRow { role: string, body: string, tone: int, width: int }
export struct FileRow { name: string, path: string, directory: bool }
export struct NeedRow { id: string, title: string, detail: string, thread-id: string, instance-id: string, approval-id: string, turn-id: string, item-id: string, decisions: string, question: bool }
export struct InfoRow { title: string, detail: string }

component IconFolder inherits Path {
    in property <color> tint: #676767;
    width: 16px; height: 16px; viewbox-width: 24; viewbox-height: 24;
    fill: transparent; stroke: tint; stroke-width: 2px; stroke-line-cap: round; stroke-line-join: round;
    commands: "M2.25 12.75V12A2.25 2.25 0 0 1 4.5 9.75h15A2.25 2.25 0 0 1 21.75 12v.75m-8.69-6.44-2.12-2.12a1.5 1.5 0 0 0-1.061-.44H4.5A2.25 2.25 0 0 0 2.25 6v12a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18V9a2.25 2.25 0 0 0-2.25-2.25h-5.379a1.5 1.5 0 0 1-1.06-.44Z";
}

